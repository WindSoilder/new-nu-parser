# Nushell grammar in PEG-style format.
#
# Format intentionally follows Zig's grammar/grammar.peg style:
#   Rule <- Expression
#   A / B is ordered choice
#   * + ? are repetition operators
#   ! is negative lookahead
#
# This is a target grammar for Nushell syntax.  The last section records the
# smaller subset currently covered by this repository's parser and tests.

Root <- Shebang? skip Block eof

# *** Top level ***

Block <- Terminator* (BlockItem (Terminator+ BlockItem)*)? Terminator*

BlockItem
    <- Declaration
     / LoopStatement
     / FlowStatement
     / Assignment
     / Pipeline

Terminator <- NEWLINE / SEMICOLON

Pipeline <- PipeElement (Pipe PipeElement)*
PipeElement <- ExpressionCommand Redirection*

Pipe
    <- OUTERR_PIPE
     / ERR_PIPE
     / PIPE

Redirection <- FileRedirection Expression

FileRedirection
    <- OUTERR_APPEND
     / OUTERR_WRITE
     / ERR_APPEND
     / ERR_WRITE
     / OUT_APPEND
     / OUT_WRITE

# *** Declarations ***

Declaration
    <- LetDecl
     / MutDecl
     / ConstDecl
     / DefDecl
     / ExternDecl
     / AliasDecl
     / ModuleDecl
     / UseDecl
     / SourceDecl
     / ExportDecl
     / ExportEnvDecl
     / HideDecl
     / OverlayDecl
     / PluginUseDecl

LetDecl <- KEYWORD_let Binding EQUAL Pipeline
MutDecl <- KEYWORD_mut Binding EQUAL Pipeline
ConstDecl <- KEYWORD_const Binding EQUAL Expression

Binding <- VariableDecl TypeAnnotation?
VariableDecl <- DOLLAR? IDENTIFIER

DefDecl <- KEYWORD_def DefOption* CommandName TypeParams? Signature IoSignature? BlockLiteral
DefOption <- FLAG_env / FLAG_wrapped

ExternDecl <- KEYWORD_extern CommandName Signature
AliasDecl <- KEYWORD_alias CommandName EQUAL Pipeline

ModuleDecl
    <- KEYWORD_module ModuleName BlockLiteral
     / KEYWORD_module ModulePath

UseDecl <- KEYWORD_use ImportPattern

SourceDecl
    <- KEYWORD_source_env Expression
     / KEYWORD_source Expression

ExportDecl <- KEYWORD_export ExportableDeclaration

ExportableDeclaration
    <- DefDecl
     / ExternDecl
     / AliasDecl
     / ConstDecl
     / ModuleDecl
     / UseDecl

ExportEnvDecl <- KEYWORD_export_env BlockLiteral

HideDecl <- KEYWORD_hide ImportPattern

OverlayDecl <- KEYWORD_overlay OverlayAction

OverlayAction
    <- KEYWORD_use OverlayUseFlag* ImportPattern OverlayRename?
     / KEYWORD_hide OverlayHideFlag* CommandName? OverlayHideFlag*
     / KEYWORD_new CommandName
     / KEYWORD_list

OverlayUseFlag <- FLAG_prefix
OverlayRename <- KEYWORD_as CommandName
OverlayHideFlag <- FLAG_keep_custom / FLAG_keep_env List

PluginUseDecl <- KEYWORD_plugin KEYWORD_use Expression

# *** Block level statements ***

Assignment <- CellRef AssignOp Pipeline

AssignOp
    <- PLUS2EQUAL
     / PLUSEQUAL
     / MINUSEQUAL
     / ASTERISKEQUAL
     / SLASHEQUAL
     / EQUAL

LoopStatement
    <- ForStatement
     / WhileStatement
     / LoopForever

ForStatement <- KEYWORD_for VariableDecl KEYWORD_in Expression BlockLiteral
WhileStatement <- KEYWORD_while Expression BlockLiteral
LoopForever <- KEYWORD_loop BlockLiteral

FlowStatement
    <- ReturnStatement
     / BreakStatement
     / ContinueStatement

ReturnStatement <- KEYWORD_return Expression?
BreakStatement <- KEYWORD_break
ContinueStatement <- KEYWORD_continue

# *** Command level ***

ExpressionCommand <- EnvShorthand* Command

EnvShorthand <- ENV_NAME EQUAL (STRING / Variable / BareWord)

Command
    <- ExternalCall
     / InternalCall
     / Expression

ExternalCall <- CARET ExternalName ExternalArg*

ExternalName
    <- CommandName
     / Variable
     / STRING

ExternalArg
    <- Spread
     / Expression
     / BareWord
     / STRING

InternalCall <- CommandName Argument*

# Nushell command heads are context-sensitive because known commands may have
# multi-word names.  A parser should resolve the longest valid known command
# name before parsing the remaining words as arguments.
CommandName
    <- STRING
     / KnownCommandName
     / IDENTIFIER

KnownCommandName <- IDENTIFIER (IDENTIFIER)+

Argument
    <- Flag
     / Spread
     / Expression
     / BareWord

Flag
    <- LongFlag ((EQUAL Expression) / Expression)?
     / ShortFlag ((EQUAL Expression) / Expression)?

LongFlag <- DASH2 FLAG_NAME
ShortFlag <- DASH SHORT_FLAGS
Spread <- DOT3 Expression

# *** Expression level ***

Expression <- RangeExpr

RangeExpr
    <- LogicalOr (RangeOp LogicalOr? (RangeOp LogicalOr?)?)?
     / RangeOp LogicalOr?

RangeOp <- DOT2_LESS / DOT2

LogicalOr <- LogicalXor (KEYWORD_or LogicalXor)*
LogicalXor <- LogicalAnd (KEYWORD_xor LogicalAnd)*
LogicalAnd <- BitOr (KEYWORD_and BitOr)*
BitOr <- BitXor (KEYWORD_bit_or BitXor)*
BitXor <- BitAnd (KEYWORD_bit_xor BitAnd)*
BitAnd <- Comparison (KEYWORD_bit_and Comparison)*

Comparison <- Shift (CompareOp Shift)*

CompareOp
    <- EQUALEQUAL
     / EXCLAMATIONEQUAL
     / LARROWEQUAL
     / RARROWEQUAL
     / LARROW
     / RARROW
     / EQUALTILDE
     / EXCLAMATIONTILDE
     / KEYWORD_not_like
     / KEYWORD_like
     / KEYWORD_not_in
     / KEYWORD_in
     / KEYWORD_not_has
     / KEYWORD_has
     / KEYWORD_not_starts_with
     / KEYWORD_starts_with
     / KEYWORD_not_ends_with
     / KEYWORD_ends_with
     / PLUS2

Shift <- Addition ((KEYWORD_bit_shl / KEYWORD_bit_shr) Addition)*
Addition <- Multiply ((PLUS / MINUS) Multiply)*
Multiply <- Power ((ASTERISK / SLASH2 / SLASH / KEYWORD_mod) Power)*
Power <- Unary (ASTERISK2 Power)?

Unary
    <- (KEYWORD_not / PLUS / MINUS) Unary
     / Postfix

Postfix <- Primary CellPath?

Primary
    <- IfExpr
     / TryExpr
     / MatchExpr
     / Literal
     / Variable
     / CellPathLiteral
     / Table
     / List
     / Closure
     / Record
     / BlockLiteral
     / Subexpression

Literal
    <- FILESIZE
     / DURATION
     / DATE
     / BINARY
     / INTERPOLATED_STRING
     / RAW_STRING
     / STRING
     / FLOAT
     / INT
     / BOOL
     / KEYWORD_null

Variable
    <- SPECIAL_VARIABLE
     / DOLLAR IDENTIFIER

SPECIAL_VARIABLE
    <- '$NU_PLUGIN_DIRS' end_of_word skip
     / '$NU_LIB_DIRS' end_of_word skip
     / '$env' end_of_word skip
     / '$in' end_of_word skip
     / '$it' end_of_word skip
     / '$nu' end_of_word skip

CellRef
    <- Variable CellPath?
     / CellPathLiteral

CellPathLiteral <- DOLLAR CellPath
CellPath <- CellMember+
CellMember <- CELL_DOT PathMember CELL_QUESTION?

PathMember
    <- STRING
     / INT
     / IDENTIFIER

Subexpression <- LPAREN Block RPAREN
BlockLiteral <- LBRACE Block RBRACE

# *** Collection literals ***

List <- LBRACKET ListItems? RBRACKET
ListItems <- ListItem (Separator? ListItem)* Separator?

ListItem
    <- Spread
     / Expression
     / BareWord

Table <- LBRACKET TableHeader SEMICOLON TableRow* RBRACKET
TableHeader <- LBRACKET TableHeaderNames? RBRACKET
TableHeaderNames <- TableHeaderName (Separator? TableHeaderName)* Separator?

TableHeaderName
    <- STRING
     / IDENTIFIER

TableRow <- LBRACKET TableRowValues? RBRACKET Separator?
TableRowValues <- TableRowValue (Separator? TableRowValue)* Separator?

TableRowValue
    <- Expression
     / BareWord

Record <- LBRACE RecordItems? RBRACE
RecordItems <- RecordItem (Separator? RecordItem)* Separator?
RecordItem <- RecordKey COLON Expression

RecordKey
    <- STRING
     / IDENTIFIER

Closure
    <- LBRACE PIPE PIPE Block RBRACE
     / LBRACE PIPE ClosureParamList? PIPE Block RBRACE
     / LBRACE Block RBRACE

ClosureParamList <- ClosureParam (COMMA ClosureParam)* COMMA?
ClosureParam <- IDENTIFIER TypeAnnotation?

Separator <- COMMA / NEWLINE / SEMICOLON

# *** Control expressions ***

IfExpr <- KEYWORD_if Expression BlockLiteral ElseClause?

ElseClause
    <- KEYWORD_else IfExpr
     / KEYWORD_else MatchExpr
     / KEYWORD_else BlockLiteral

TryExpr <- KEYWORD_try BlockLiteral CatchClause? FinallyClause?
CatchClause <- KEYWORD_catch (Closure / BlockLiteral)
FinallyClause <- KEYWORD_finally BlockLiteral

MatchExpr <- KEYWORD_match Expression MatchBlock
MatchBlock <- LBRACE MatchArm (Separator MatchArm)* Separator? RBRACE
MatchArm <- Pattern Guard? FATARROW (Expression / BlockLiteral)
Guard <- KEYWORD_if Expression

Pattern <- OrPattern
OrPattern <- SinglePattern (PIPE SinglePattern)*

SinglePattern
    <- UNDERSCORE
     / Literal
     / Variable
     / ListPattern
     / RecordPattern

ListPattern <- LBRACKET Pattern (COMMA Pattern)* COMMA? RBRACKET
RecordPattern <- LBRACE RecordPatternItem (COMMA RecordPatternItem)* COMMA? RBRACE
RecordPatternItem <- RecordKey COLON Pattern

# *** Signatures and types ***

Signature <- LBRACKET SignatureParam (Separator? SignatureParam)* Separator? RBRACKET

SignatureParam
    <- RestParam
     / FlagParam
     / ShortOnlyFlag
     / PositionalParam

PositionalParam <- IDENTIFIER QUESTIONMARK? TypeAnnotation? DefaultValue?
RestParam <- DOT3 IDENTIFIER TypeAnnotation?
FlagParam <- LongFlag ShortFlagAlias? TypeAnnotation? DefaultValue?
ShortOnlyFlag <- ShortFlag TypeAnnotation? DefaultValue?
ShortFlagAlias <- LPAREN ShortFlag RPAREN
DefaultValue <- EQUAL Expression

IoSignature
    <- COLON LBRACKET InOutType (Separator? InOutType)* Separator? RBRACKET
     / COLON InOutType

InOutType <- Type THINARROW Type

TypeAnnotation <- COLON Type Completer?
Completer <- AT CommandName

TypeParams <- LARROW IDENTIFIER (COMMA IDENTIFIER)* COMMA? RARROW

Type
    <- KEYWORD_record LARROW RecordTypeFields? RARROW QUESTIONMARK?
     / IDENTIFIER TypeArgs? QUESTIONMARK?

TypeArgs <- LARROW Type (COMMA Type)* COMMA? RARROW
RecordTypeFields <- RecordTypeField (COMMA RecordTypeField)* COMMA?
RecordTypeField <- RecordKey TypeAnnotation?

# *** Imports and modules ***

ImportPattern <- ModuleRef ImportMembers?

ModuleRef
    <- ModulePath
     / ModuleName

ImportMembers
    <- ASTERISK
     / CommandName
     / LBRACKET ImportMemberList? RBRACKET

ImportMemberList <- ImportMember (Separator? ImportMember)* Separator?

ImportMember
    <- ASTERISK
     / STRING
     / CommandName

ModuleName
    <- STRING
     / CommandName

ModulePath
    <- PATH
     / STRING

# *** Lexical helpers ***

eof <- !.

skip <- ([ \t] / LineComment)*
LineComment <- '#' [^\n\r]*
Shebang <- '#!' [^\n\r]* NEWLINE

NEWLINE <- ('\r\n' / '\n' / '\f') skip

hex <- [0-9a-fA-F]
oct <- [0-7]
bin <- [01]
dec <- [0-9]
sign <- [+-]
dec_int <- dec ('_'? dec)*
hex_int <- hex ('_'? hex)*
oct_int <- oct ('_'? oct)*
bin_int <- bin ('_'? bin)*
number
    <- sign? dec_int? '.' dec_int ([eE] sign? dec_int)?
     / sign? dec_int '.' dec_int? ([eE] sign? dec_int)?
     / sign? dec_int

INT
    <- sign? '0x' hex_int skip
     / sign? '0o' oct_int skip
     / sign? '0b' bin_int skip
     / sign? dec_int skip

FLOAT
    <- sign? dec_int? '.' dec_int ([eE] sign? dec_int)? skip
     / sign? dec_int '.' dec_int? ([eE] sign? dec_int)? skip
     / 'Infinity' skip
     / '-Infinity' skip
     / 'NaN' skip

FILESIZE <- number FileSizeUnit skip
FileSizeUnit <- 'B' / 'KB' / 'KiB' / 'MB' / 'MiB' / 'GB' / 'GiB' / 'TB' / 'TiB' / 'PB' / 'PiB'

DURATION <- number DurationUnit skip
DurationUnit <- 'ns' / 'us' / 'ms' / 'sec' / 'min' / 'hr' / 'day' / 'wk'

DATE <- dec dec dec dec '-' dec dec '-' dec dec DateTimeTail? skip
DateTimeTail <- 'T' dec dec ':' dec dec ':' dec dec ('.' dec+)? TimeZone?
TimeZone <- 'Z' / sign dec dec ':' dec dec

BINARY
    <- '0x[' (hex hex? skip)* ']' skip
     / '0o[' (oct skip)* ']' skip
     / '0b[' (bin skip)* ']' skip

BOOL
    <- KEYWORD_true
     / KEYWORD_false

STRING
    <- SINGLE_QUOTED_STRING
     / DOUBLE_QUOTED_STRING
     / BACKTICK_STRING

SINGLE_QUOTED_STRING <- ['] (!['] .)* ['] skip
DOUBLE_QUOTED_STRING <- '"' (Escape / !["\\\n\r] .)* '"' skip
BACKTICK_STRING <- '`' (!'`' .)* '`' skip
RAW_STRING <- 'r' '#'+ ['] RawStringChar* ['] '#'+ skip
RawStringChar <- !(['] '#') .

INTERPOLATED_STRING
    <- '$"' InterpolationPart* '"' skip
     / "$'" InterpolationPart* "'" skip

InterpolationPart
    <- LPAREN Block RPAREN
     / InterpolationChar+

InterpolationChar <- Escape / ![()'"\n\r] .
Escape <- '\\' [\\"'bnfrt()]

PATH <- PathChar+ skip
PathChar <- ![ \t\r\n,;()\[\]{}|'"`] .

BareWord <- BARE
BARE <- !Keyword BareChar+ skip
BareChar <- ![ \t\r\n,;()\[\]{}|$'"`] .

IDENTIFIER <- !Keyword IdentifierChar+ skip
IdentifierChar <- ![ \t\r\n.\[\]({+\-*^/=!<>&|,;:'"`}] .

ENV_NAME <- IdentifierChar+ skip
FLAG_NAME <- IdentifierChar+ ('-' IdentifierChar+)* skip
SHORT_FLAGS <- [A-Za-z]+ skip

# *** Tokens ***

SEMICOLON <- ';' skip
COMMA <- ',' skip
COLON <- ':' skip
THINARROW <- '->' skip
FATARROW <- '=>' skip
LPAREN <- '(' skip
RPAREN <- ')' skip
LBRACKET <- '[' skip
RBRACKET <- ']' skip
LBRACE <- '{' skip
RBRACE <- '}' skip
AT <- '@' skip
CARET <- '^' skip
DOLLAR <- '$'
UNDERSCORE <- '_' skip
QUESTIONMARK <- '?' skip
CELL_DOT <- '.'
CELL_QUESTION <- '?'

OUTERR_PIPE <- ('out+err>|' / 'err+out>|' / 'o+e>|' / 'e+o>|') skip
ERR_PIPE <- ('err>|' / 'e>|') skip
PIPE <- '|' skip

OUTERR_APPEND <- ('out+err>>' / 'err+out>>' / 'o+e>>' / 'e+o>>') skip
OUTERR_WRITE <- ('out+err>' / 'err+out>' / 'o+e>' / 'e+o>') skip
ERR_APPEND <- ('err>>' / 'e>>') skip
ERR_WRITE <- ('err>' / 'e>') skip
OUT_APPEND <- ('out>>' / 'o>>') skip
OUT_WRITE <- ('out>' / 'o>') skip

DOT3 <- '...' skip
DOT2_LESS <- '..<' skip
DOT2 <- '..' skip
DOT <- '.' skip

PLUS2EQUAL <- '++=' skip
PLUS2 <- '++' skip
PLUSEQUAL <- '+=' skip
PLUS <- '+' skip
MINUSEQUAL <- '-=' skip
MINUS <- '-' skip
ASTERISK2 <- '**' skip
ASTERISKEQUAL <- '*=' skip
ASTERISK <- '*' skip
SLASH2 <- '//' skip
SLASHEQUAL <- '/=' skip
SLASH <- '/' skip
EQUALEQUAL <- '==' skip
EQUALTILDE <- '=~' skip
EQUAL <- '=' skip
EXCLAMATIONEQUAL <- '!=' skip
EXCLAMATIONTILDE <- '!~' skip
LARROWEQUAL <- '<=' skip
LARROW <- '<' skip
RARROWEQUAL <- '>=' skip
RARROW <- '>' skip
DASH2 <- '--'
DASH <- '-'

FLAG_env <- '--env' skip
FLAG_wrapped <- '--wrapped' skip
FLAG_prefix <- '--prefix' skip
FLAG_keep_custom <- '--keep-custom' skip
FLAG_keep_env <- '--keep-env' skip

end_of_word <- ![A-Za-z0-9_-]

KEYWORD_alias <- 'alias' end_of_word skip
KEYWORD_and <- 'and' end_of_word skip
KEYWORD_as <- 'as' end_of_word skip
KEYWORD_bit_and <- 'bit-and' end_of_word skip
KEYWORD_bit_or <- 'bit-or' end_of_word skip
KEYWORD_bit_shl <- 'bit-shl' end_of_word skip
KEYWORD_bit_shr <- 'bit-shr' end_of_word skip
KEYWORD_bit_xor <- 'bit-xor' end_of_word skip
KEYWORD_break <- 'break' end_of_word skip
KEYWORD_catch <- 'catch' end_of_word skip
KEYWORD_const <- 'const' end_of_word skip
KEYWORD_continue <- 'continue' end_of_word skip
KEYWORD_def <- 'def' end_of_word skip
KEYWORD_else <- 'else' end_of_word skip
KEYWORD_ends_with <- 'ends-with' end_of_word skip
KEYWORD_export_env <- 'export-env' end_of_word skip
KEYWORD_export <- 'export' end_of_word skip
KEYWORD_extern <- 'extern' end_of_word skip
KEYWORD_false <- 'false' end_of_word skip
KEYWORD_finally <- 'finally' end_of_word skip
KEYWORD_for <- 'for' end_of_word skip
KEYWORD_has <- 'has' end_of_word skip
KEYWORD_hide <- 'hide' end_of_word skip
KEYWORD_if <- 'if' end_of_word skip
KEYWORD_in <- 'in' end_of_word skip
KEYWORD_let <- 'let' end_of_word skip
KEYWORD_like <- 'like' end_of_word skip
KEYWORD_list <- 'list' end_of_word skip
KEYWORD_loop <- 'loop' end_of_word skip
KEYWORD_match <- 'match' end_of_word skip
KEYWORD_mod <- 'mod' end_of_word skip
KEYWORD_module <- 'module' end_of_word skip
KEYWORD_mut <- 'mut' end_of_word skip
KEYWORD_new <- 'new' end_of_word skip
KEYWORD_not <- 'not' end_of_word skip
KEYWORD_not_ends_with <- 'not-ends-with' end_of_word skip
KEYWORD_not_has <- 'not-has' end_of_word skip
KEYWORD_not_in <- 'not-in' end_of_word skip
KEYWORD_not_like <- 'not-like' end_of_word skip
KEYWORD_not_starts_with <- 'not-starts-with' end_of_word skip
KEYWORD_null <- 'null' end_of_word skip
KEYWORD_or <- 'or' end_of_word skip
KEYWORD_overlay <- 'overlay' end_of_word skip
KEYWORD_plugin <- 'plugin' end_of_word skip
KEYWORD_record <- 'record' end_of_word skip
KEYWORD_return <- 'return' end_of_word skip
KEYWORD_source_env <- 'source-env' end_of_word skip
KEYWORD_source <- 'source' end_of_word skip
KEYWORD_starts_with <- 'starts-with' end_of_word skip
KEYWORD_true <- 'true' end_of_word skip
KEYWORD_try <- 'try' end_of_word skip
KEYWORD_use <- 'use' end_of_word skip
KEYWORD_while <- 'while' end_of_word skip
KEYWORD_xor <- 'xor' end_of_word skip

Keyword
    <- KEYWORD_alias
     / KEYWORD_and
     / KEYWORD_as
     / KEYWORD_bit_and
     / KEYWORD_bit_or
     / KEYWORD_bit_shl
     / KEYWORD_bit_shr
     / KEYWORD_bit_xor
     / KEYWORD_break
     / KEYWORD_catch
     / KEYWORD_const
     / KEYWORD_continue
     / KEYWORD_def
     / KEYWORD_else
     / KEYWORD_ends_with
     / KEYWORD_export_env
     / KEYWORD_export
     / KEYWORD_extern
     / KEYWORD_false
     / KEYWORD_finally
     / KEYWORD_for
     / KEYWORD_has
     / KEYWORD_hide
     / KEYWORD_if
     / KEYWORD_in
     / KEYWORD_let
     / KEYWORD_like
     / KEYWORD_list
     / KEYWORD_loop
     / KEYWORD_match
     / KEYWORD_mod
     / KEYWORD_module
     / KEYWORD_mut
     / KEYWORD_new
     / KEYWORD_not_ends_with
     / KEYWORD_not_has
     / KEYWORD_not_in
     / KEYWORD_not_like
     / KEYWORD_not_starts_with
     / KEYWORD_not
     / KEYWORD_null
     / KEYWORD_or
     / KEYWORD_overlay
     / KEYWORD_plugin
     / KEYWORD_record
     / KEYWORD_return
     / KEYWORD_source_env
     / KEYWORD_source
     / KEYWORD_starts_with
     / KEYWORD_true
     / KEYWORD_try
     / KEYWORD_use
     / KEYWORD_while
     / KEYWORD_xor

# *** Current repository checkpoint ***

ImplementedBlockItem
    <- DefDecl
     / ExternDecl
     / LetDecl
     / MutDecl
     / AliasDecl
     / ForStatement
     / WhileStatement
     / LoopForever
     / ReturnStatement
     / BreakStatement
     / ContinueStatement
     / Assignment
     / Pipeline

ImplementedPrimary
    <- INT
     / FLOAT
     / STRING
     / BOOL
     / KEYWORD_null
     / Variable
     / List
     / Table
     / Record
     / Closure
     / Subexpression
     / IfExpr
     / TryExpr
     / MatchExpr

ImplementedOperator
    <- ASTERISK2
     / ASTERISK
     / SLASH2
     / SLASH
     / KEYWORD_mod
     / PLUS2
     / PLUS
     / MINUS
     / EQUALEQUAL
     / EXCLAMATIONEQUAL
     / LARROWEQUAL
     / RARROWEQUAL
     / LARROW
     / RARROW
     / EQUALTILDE
     / EXCLAMATIONTILDE
     / KEYWORD_in
     / KEYWORD_and
     / KEYWORD_xor
     / KEYWORD_or
     / AssignOp

# The remaining declaration, module/import, external-command, full flag,
# redirection, and literal forms above describe the expected Nushell target
# surface rather than completed local implementation.
#
# Main references:
# - https://codeberg.org/ziglang/zig-spec/src/branch/master/grammar/grammar.peg
# - https://raw.githubusercontent.com/ziglang/zig-spec/master/grammar/grammar.peg
# - https://www.nushell.sh/book/
